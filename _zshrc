function fzf-select-history() {
  BUFFER=$(history -n -r 1 | fzf --query "$LBUFFER" --reverse)
  CURSOR=$#BUFFER
  zle reset-prompt
}
zle -N fzf-select-history
bindkey '^r' fzf-select-history

# fkill - kill process
fkill() {
  local pid
  pid=$(ps -ef | sed 1d | fzf -m | awk '{print $2}')

  if [ "x$pid" != "x" ]
  then
    echo $pid | xargs kill -${1:-9}
  fi
}

# ghq get wrapper with optional root path
ghq-get() {
  _has_cmd ghq || return 127
  local root=""
  local OPTIND opt

  while getopts "p:" opt; do
    case "$opt" in
      p) root="$OPTARG" ;;
      *)
        echo "Usage: ghq-get [-p root_path] <owner/repo | url>"
        return 1
        ;;
    esac
  done
  shift $((OPTIND - 1))

  if [ $# -lt 1 ]; then
    echo "Usage: ghq-get [-p root_path] <owner/repo | url>"
    return 1
  fi

  # root 未指定ならカレントディレクトリ
  if [ -z "$root" ]; then
    root="$PWD"
  fi

  # パス正規化 & 存在チェック
  root="$(cd "$root" 2>/dev/null && pwd)"
  if [ -z "$root" ] || [ ! -d "$root" ]; then
    echo "Error: invalid root path"
    return 1
  fi

  GHQ_ROOT="$root" ghq get "$@"
}

ghq-cd() {
  _has_cmd ghq || return 127
  # disable xtrace locally (even if set -x is on globally)
  set +x 2>/dev/null

  # リポジトリ置き場。GHQ_ROOTS_DIR で差し替えられる
  local roots=()
  for d in "${GHQ_ROOTS_DIR:-$HOME/wk}"/*; do
    [ -d "$d" ] && roots+=("$d")
  done
  [ ${#roots[@]} -eq 0 ] && return 0

  local tmp
  tmp=$(mktemp) || return 1

  for r in "${roots[@]}"; do
    GHQ_ROOT="$r" ghq list -p 2>/dev/null | while IFS= read -r repo; do
      [ -z "$repo" ] && continue
      printf '%s\t%s\t%s\n' "$(basename "$r")" "$repo" "$r"
    done >>"$tmp"
  done

  [ ! -s "$tmp" ] && { rm -f "$tmp"; return 0; }

  local selection
  selection=$(
    awk -F $'\t' '{ printf("%-12s\t%s\t%s\n", $1, $2, $3) }' "$tmp" |
      fzf --height=40% --layout=reverse --border \
          --delimiter=$'\t' --with-nth=1,2 \
          --prompt='ghq> ' \
          --preview-window='right:60%,wrap' \
          --preview '
            repo=$(echo {} | awk -F "\t" "{print \$2}")
            root=$(echo {} | awk -F "\t" "{print \$3}")
            case "$repo" in
              /*) path="$repo" ;;
              *) path="$root/$repo" ;;
            esac
            [ ! -d "$path" ] && exit 0

            git -C "$path" status --short --branch 2>/dev/null | sed -n "1,20p"
            echo
            git -C "$path" log -1 --oneline 2>/dev/null
            echo
            [ -f "$path/README.md" ] && sed -n "1,120p" "$path/README.md"
            echo
            find "$path" -maxdepth 1 -type f -printf "%f\n" 2>/dev/null | sed -n "1,200p"
          '
  )

  rm -f "$tmp"
  [ -z "$selection" ] && return 0

  local repo root target
  repo=$(echo "$selection" | awk -F $'\t' '{print $2}')
  root=$(echo "$selection" | awk -F $'\t' '{print $3}')

  case "$repo" in
    /*) target="$repo" ;;
    *) target="$root/$repo" ;;
  esac

  [ -d "$target" ] && cd "$target"
}


# keybinds for ghq-cd
if [[ -n $ZSH_VERSION ]]; then
  zle -N ghq-cd-widget ghq-cd
  bindkey '^]' ghq-cd-widget
  bindkey '^q' ghq-cd-widget
fi
