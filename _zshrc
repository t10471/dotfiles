# source ~/bin/emsdk/emsdk_env.sh

export PATH="$HOME/.local/bin:/usr/local/bin:$HOME/bin:$PATH"
export EDITOR=nvim
# workaround git gettext problem
export GIT_INTERNAL_GETTEXT_TEST_FALLBACKS=1

# 未導入のコマンドに依存する設定を黙って飛ばすための判定
_has_cmd() { command -v "$1" >/dev/null 2>&1; }

# Starship: only for interactive + real terminals
if [[ -o interactive ]] && [[ "${TERM:-}" != "dumb" ]] && _has_cmd starship; then
  eval "$(starship init zsh)"
fi
_has_cmd direnv && eval "$(direnv hook zsh)"
_has_cmd mise && eval "$(mise activate zsh)"
autoload -Uz compinit && compinit
_has_cmd sheldon && eval "$(sheldon source)"
_has_cmd fzf && source <(fzf --zsh)
_has_cmd zoxide && eval "$(zoxide init zsh)"

alias ovim=vim
_has_cmd nvim && alias vim=nvim
_has_cmd delta && alias diff=delta
_has_cmd terraform && alias tf=terraform
alias g=git
alias k=kubectl
alias kc=kubectl
alias kg='kubectl get'
alias kd='kubectl describe'
alias sudo='sudo '
if _has_cmd eza; then
  alias ls=eza
  alias ll='eza -l --git'
  alias la='eza -la --git'
  alias lt='eza -l -T --git'
fi
if _has_cmd zoxide; then
  alias cd='z'
  alias cdi='zi'
fi
unalias cc 2>/dev/null
cc() {
  _has_cmd claude || return 127
  if [[ "$1" == "-w" ]]; then
    local selected
    selected=$(
      { echo "[new]"; ls -d .worktrees/*/ 2>/dev/null | sed 's|\.worktrees/||;s|/$||'; } |
      fzf --prompt="worktree> "
    )
    if [[ "$selected" == "[new]" ]]; then
      claude --dangerously-skip-permissions -w
    elif [[ -n "$selected" ]]; then
      cd ".worktrees/$selected" && claude --dangerously-skip-permissions
    fi
  elif [[ "$1" == "-c" ]]; then
    shift
    claude --continue --dangerously-skip-permissions "$@"
  else
    claude --dangerously-skip-permissions "$@"
  fi
}

